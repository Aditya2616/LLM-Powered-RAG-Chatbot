# Copy to .env and edit. Every setting is optional: with none set, the service uses
# local models (no key needed): MiniLM embeddings and a small Qwen instruct model.

# ---- providers -------------------------------------------------------------------------
# Embeddings: huggingface (default, local) | openai | gemini | hashing (no model, lexical)
EMBEDDINGS_PROVIDER=huggingface
# Generator: local (default) | openai | gemini | extractive (no model: returns the best sentence)
LLM_PROVIDER=local
# auto | cpu | cuda
RAG_DEVICE=auto

# Local models (Hugging Face ids)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Hosted providers: the model id has no default and must be set here.
# OpenAI, or any server that speaks the same protocol (set OPENAI_BASE_URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Optional cross-encoder reranker (a Hugging Face id); empty = off
RERANKER_MODEL=

# ---- retrieval -------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=75
TOP_K=4
# dense | bm25 | hybrid
RETRIEVER=hybrid
# Abstain without calling the model when the best chunk's cosine similarity is below this; off = no gate
MIN_DENSE_SCORE=off

# ---- generation ------------------------------------------------------------------------
MAX_NEW_TOKENS=160
TEMPERATURE=0
# Put two worked examples (one answer, one "I don't know") in front of the question
FEW_SHOT=false

# ---- service ---------------------------------------------------------------------------
RAG_DATA_DIR=data
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=10
CACHE_MAXSIZE=256
CACHE_TTL_SECONDS=3600
MAX_HISTORY_TURNS=5
SESSION_TTL_SECONDS=3600
LOG_LEVEL=INFO
